["nvi",{"name":"NVI","metadata":{},"books":[{"number":1,"name":"Gênesis","chapters":[{"number":1,"verses":[{"number":1,"text":"No princípio Deus criou os céus e a terra."},{"number":2,"text":"Era a terra sem forma e vazia."},{"number":3,"text":"Disse Deus: haja luz."}]}]},{"number":43,"name":"João","chapters":[{"number":3,"verses":[{"number":16,"text":"Porque Deus tanto amou o mundo que deu o seu Filho Unigênito."},{"number":17,"text":"Pois Deus enviou o seu Filho ao mundo para salvá-lo."},{"number":18,"text":"Quem nele crê não é condenado."}]}]}]}]