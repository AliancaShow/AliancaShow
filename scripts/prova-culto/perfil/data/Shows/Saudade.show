["impulso_saudade",{"name":"Saudade","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":null,"used":null},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Tão pequeno eu sou diante da tua glória","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E mesmo assim me olha","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Com tanto amor","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Seu singelo amor me envolve em tua graça","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Vem Senhor, me toca com seu ardor","style":"font-size: 100px;"}]}]}]},"refrao":{"group":"Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Eu sinto saudade","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Do seu coração","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Batendo em mim","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Eu sinto vontade","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"De estar em teus braços","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E nunca mais sair","style":"font-size: 100px;"}]}]}]},"ponte":{"group":"Ponte","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Eu não sei viver sem tua presença","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Vazio eu seria, sem ti meu Jesus","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Sem você, de mim não sobra nada","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Toda minha vida é pra ti adorar","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Saudade","notes":"","slides":[{"id":"verso_1"},{"id":"refrao"},{"id":"ponte"}]}},"media":{}}]