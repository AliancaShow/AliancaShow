["impulso_voz_da_criacao",{"name":"Voz da Criação","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":null,"used":null},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"No princípio era o verbo","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Deus que se fez carne","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Luz pros homens se tornou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Estava com Deus, Ele era Deus","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Sem Ele não há vida","style":"font-size: 100px;"}]}]}]},"verso_2":{"group":"Verso 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Tu és a voz da criação","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"O Deus que veio e lutou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E chave do inferno tomou","style":"font-size: 100px;"}]}]}]},"pre_refrao":{"group":"Pré-Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"E nem a morte te segurou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Quero ir contigo por onde for, eu vou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Viver o seu amor","style":"font-size: 100px;"}]}]}]},"refrao":{"group":"Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Ele tabernaculou, com seu povo andou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Levou os meus pecados, hoje livre eu sou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Ele se entregou, o meu corpo curou","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Por isso grato sou","style":"font-size: 100px;"}]}]}]},"ponte":{"group":"Ponte","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"PRA VIVER","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"O SEU","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"AMORR OOO OO O O","style":"font-size: 100px;"}]}]}]},"refrao_2":{"group":"Refrão 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Queremos ver o seu reino descer aqui","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Queremos ver o seu avivamento aqui","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Queremos ser aqueles que tu escolheu","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Queremos ter aquilo que nos prometeu","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Voz da Criação","notes":"","slides":[{"id":"verso_1"},{"id":"verso_2"},{"id":"pre_refrao"},{"id":"refrao"},{"id":"ponte"},{"id":"refrao_2"},{"id":"ponte"}]}},"media":{}}]