["impulso_aos_teus_pes",{"name":"Aos Teus Pés","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":1794704208214,"used":1794704208214},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Uma vida é pouco para Te amar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Tudo que tenho quero Te entregar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Sua voz é tão doce aqui","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Seu abraço é tão quente","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Seus olhos me incendeiam de amor","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Meu coração Te leva aonde for","style":"font-size: 100px;"}]}]}]},"pre_refrao":{"group":"Pré-Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Não posso viver sem Ti","style":"font-size: 100px;"}]}]}]},"refrao_1":{"group":"Refrão 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Eis-me aqui, eu sou aquele","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Que Tu chamas pelo nome","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Eu irei","style":"font-size: 100px;"}]}]}]},"refrao_2":{"group":"Refrão 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Senhor, eu Te amo","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Senhor, eu Te quero","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Não só uma noite, mas","style":"font-size: 100px;