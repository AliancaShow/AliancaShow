["impulso_te_adoraremos",{"name":"Te Adoraremos","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":null,"used":null},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Vi no céu a esperança","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"A luz dos homens nessa terra","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Nele o meu prazer está","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"És onde habita a alegria","style":"font-size: 100px;"}]}]}]},"pre_refrao":{"group":"Pré-Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Minha alma anseia por ti","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Em ver seus olhos como chamas","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Minha alma anseio por ti","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Meu rei, eu sei que tu és por mim","style":"font-size: 100px;"}]}]}]},"refrao":{"group":"Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Te adoraremos, no meio do vale louvaremos","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"A todo tempo, a ti seja a honra e o louvor","style":"font-size: 100px;"}]}]}]},"refrao_2":{"group":"Refrão 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Ao rei que está assentado cantamos","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Aleluia","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Somente aquele que é digno exaltamos","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Aleluia","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Te Adoraremos","notes":"","slides":[{"id":"verso_1"},{"id":"pre_refrao"},{"id":"refrao"},{"id":"refrao_2"}]}},"media":{}}]