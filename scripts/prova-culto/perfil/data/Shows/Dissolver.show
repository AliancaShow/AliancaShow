["impulso_dissolver",{"name":"Dissolver","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":1794704528255,"used":1794704528255},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"És a minha fonte, meu horizonte","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Meu coração é tua casa, vem morar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Por onde eu passar, que possam enxergar a ti em mim","style":"font-size: 100px;"}]}]}]},"verso_2":{"group":"Verso 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"És o meu abrigo, meu motivo de sorrir a sós","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Me achou perdido quando tudo que restou foi só","style":"font-size: 100px;"}]}]}]},"refrao":{"group":"Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Faça dissolver, desintegrar, todo medo de me aproximar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Do teu amor, és meu Senhor, único que pode me salvar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Faça eu lembrar o meu lugar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Reconstruir o teu altar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E te entregar o que é meu","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"O que é meu é tão seu","style":"font-size: 100px;"}]}]}]},"ponte":{"group":"Ponte","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Ouço tua voz ao meu calar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Posso respirar sem medo","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Vejo tudo me mostrar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Que esse é meu lugar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Me rendo","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Dissolver","notes":"","slides":[{"id":"verso_1"},{"id":"verso_2"},{"id":"refrao"},{"id":"ponte"}]}},"media":{}}]