["impulso_fome_e_sede",{"name":"Fome e Sede","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":1794703825508,"used":1794703825508},"quickAccess":{},"meta":{},"slides":{"intro":{"group":"Intro","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Fome que não morre","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Sede que não passa","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Me entrego pra ter mais de ti","style":"font-size: 100px;"}]}]}]},"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Sacia meu desejo","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"A minha vontade","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Da tua presença em mim","style":"font-size: 100px;"}]}]}]},"pre_refrao":{"group":"Pré-Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"O pão que só tu tens","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E que eu não se encontra em outro lugar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Eu não vou parar até te alcançar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Meu coração deseja","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Toda minha alma anseia por ti","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Me ensina a fazer tua vontade","style":"font-size: 100px;"}]}]}]},"refrao_1":{"group":"Refrão 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Quando nada mais importa","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Tudo perde o valor perante a ti","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Só tu me satisfaz! Só tu me satisfaz!","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Eu me alimento da tua glória","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E do mover do teu Espírito em mim","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Só tu me satisfaz! Só tu me satisfaz!","style":"font-size: 100px;"}]}]}]},"refrao_2":{"group":"Refrão 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Tu que me move, tu que me abraça","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Tu que me acolhe em tua graça","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Encontrei amor","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Eu dependo de ti, Senhor","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Fome e Sede","notes":"","slides":[{"id":"intro"},{"id":"verso_1"},{"id":"pre_refrao"},{"id":"refrao_1"},{"id":"refrao_2"}]}},"media":{}}]