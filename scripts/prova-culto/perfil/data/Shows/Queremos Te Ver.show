["impulso_queremos_te_ver",{"name":"Queremos Te Ver","category":"impulso","settings":{"activeLayout":"default","template":"default"},"timestamps":{"created":1788307200000,"modified":null,"used":null},"quickAccess":{},"meta":{},"slides":{"verso_1":{"group":"Verso 1","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Em teus passos, eu quero andar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Seu sorriso vem, me avivar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Suas mãos, quero tocar","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Em teus braços me lançar","style":"font-size: 100px;"}]}]}]},"ponte":{"group":"Ponte","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"E ele vem, ele vem, aqui","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E ele vem, ele vem, aqui","style":"font-size: 100px;"}]}]}]},"refrao":{"group":"Refrão","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Tua noiva te espera","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Com tua glória enche a terra","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Vem Jesus","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"As lamparinas já estão acesas","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Queremos te ver, te ver","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Vem Jesus","style":"font-size: 100px;"}]}]}]},"verso_2":{"group":"Verso 2","color":null,"settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","align":"","lines":[{"align":"","text":[{"value":"Tu prometestes que viria","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Tu percorrestes o caminho","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Foram perfuradas as suas mãos","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Junto com elas o meu coração","style":"font-size: 100px;"}]}]}]}},"layouts":{"default":{"name":"Queremos Te Ver","notes":"","slides":[{"id":"verso_1"},{"id":"ponte"},{"id":"refrao"},{"id":"verso_2"}]}},"media":{}}]